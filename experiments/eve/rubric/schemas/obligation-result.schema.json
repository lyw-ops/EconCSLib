{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criterion_id": {
      "minLength": 3,
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "criterion_id",
    "status",
    "evidence",
    "rationale"
  ],
  "title": "EVE obligation result",
  "type": "object"
}
