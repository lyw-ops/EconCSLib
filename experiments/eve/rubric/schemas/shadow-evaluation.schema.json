{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "controls_selection": {
      "const": false,
      "type": "boolean"
    },
    "failure_frontier": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hard_oracle": {
      "additionalProperties": false,
      "properties": {
        "adapter_path": {
          "type": "string"
        },
        "failure_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hard_accepted": {
          "type": "boolean"
        },
        "report_sha256": {
          "minLength": 64,
          "type": "string"
        },
        "score": {
          "enum": [
            0.0,
            1.0
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        }
      },
      "required": [
        "adapter_path",
        "status",
        "score",
        "hard_accepted",
        "failure_codes",
        "report_sha256"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mathematical_acceptance": {
      "const": false,
      "type": "boolean"
    },
    "obligations": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "route": {
      "enum": [
        "direct",
        "transport"
      ]
    },
    "rubric_id": {
      "const": "EVE-RUBRIC-R000",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "score_semantics": {
      "const": "non-authoritative-shadow-only",
      "type": "string"
    },
    "shadow_search_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "rubric_id",
    "candidate_id",
    "route",
    "hard_oracle",
    "obligations",
    "failure_frontier",
    "shadow_search_score",
    "score_semantics",
    "controls_selection",
    "mathematical_acceptance",
    "limitations"
  ],
  "title": "EVE R000 shadow evaluation",
  "type": "object"
}
