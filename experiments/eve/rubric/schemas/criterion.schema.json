{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applies_when": {
      "enum": [
        "all",
        "direct",
        "transport",
        "paired"
      ]
    },
    "criterion_id": {
      "minLength": 3,
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_strength": {
      "enum": [
        "lean_kernel",
        "deterministic_contract",
        "deterministic_static",
        "syntactic_only",
        "review_only"
      ]
    },
    "kind": {
      "enum": [
        "hard_mirror",
        "semantic_progress",
        "review_only"
      ]
    },
    "name_en": {
      "minLength": 1,
      "type": "string"
    },
    "name_zh": {
      "minLength": 1,
      "type": "string"
    },
    "prerequisites": {
      "items": {
        "minLength": 3,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "protected": {
      "type": "boolean"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "score_role": {
      "enum": [
        "fatal",
        "frontier",
        "diagnostic_only"
      ]
    },
    "severity": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    }
  },
  "required": [
    "criterion_id",
    "name_zh",
    "name_en",
    "description",
    "scope",
    "kind",
    "severity",
    "applies_when",
    "prerequisites",
    "evidence_sources",
    "evidence_strength",
    "score_role",
    "protected"
  ],
  "title": "EVE rubric criterion",
  "type": "object"
}
