{
  "schema_version": "1.0.0",
  "task_id": "EVE-ENTRY-GAME-PAIRED-001",
  "public_development_corpus": true,
  "mutations": [
    {
      "id": "DIRECT-UNFIXED",
      "route": "direct",
      "base": "seed",
      "operations": [],
      "expected_failure": "route-discipline-violation",
      "review_reason": "Required direct conclusions are absent."
    },
    {
      "id": "DIRECT-PLACEHOLDER",
      "route": "direct",
      "base": "accepted",
      "operations": [{"kind": "insert_after_marker", "text": "\nsorry\n"}],
      "expected_failure": "forbidden-construct",
      "review_reason": "A placeholder cannot certify a proof."
    },
    {
      "id": "DIRECT-ABSTRACT-LEAK",
      "route": "direct",
