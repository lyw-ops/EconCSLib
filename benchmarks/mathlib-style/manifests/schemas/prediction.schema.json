          "items": {
            "$ref": "common.schema.json#/$defs/finding"
          }
        },
        "missing_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "A",
            "B",
            "TIE",
            "INSUFFICIENT_CONTEXT"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "answerability": {
                "const": "INSUFFICIENT_CONTEXT"
              }
            },
            "required": [
              "answerability"
            ]
          },
          "then": {
            "properties": {
              "missing_context": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "missing_context": {
                "maxItems": 0
              }
            }
          }
        },
        {
