              "verdict": {
                "const": "INSUFFICIENT_CONTEXT"
              }
            }
          },
          "else": {
            "properties": {
              "verdict": {
                "enum": [
                  "A",
                  "B",
                  "TIE"
                ]
              }
            }
          }
        }
      ]
