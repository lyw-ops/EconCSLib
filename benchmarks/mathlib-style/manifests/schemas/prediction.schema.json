  "$id": "https://econcs.example/mathlib-style/prediction.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "case_id",
        "task",
        "answerability",
        "confidence",
        "findings",
        "missing_context",
        "rationale",
        "verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "0.3.0"
        },
        "case_id": {
          "$ref": "common.schema.json#/$defs/caseId"
        },
        "task": {
          "const": "PAIR"
